{
  "entity": {
    "datetime": {
      "filled_at": {
        "default": "mdi:calendar-check"
      }
    },
    "text": {
      "content": {
        "default": "mdi:food-variant"
      }
    },
    "button": {
      "empty_container": {
        "default": "mdi:delete-empty"
      }
    },
    "date": {
      "best_before": {
        "default": "mdi:calendar-alert"
      }
    },
    "image": {
      "qr_code": {
        "default": "mdi:qrcode"
      }
    },
    "switch": {
      "vacuum": {
        "default": "mdi:air-filter",
        "state": {
          "off": "mdi:package-variant-closed"
        }
      },
      "shopping": {
        "default": "mdi:cart",
        "state": {
          "off": "mdi:cart-off"
        }
      },
      "flexible": {
        "default": "mdi:map-marker-path"
      }
    },
    "sensor": {
      "days_left": {
        "default": "mdi:timer-sand"
      }
    },
    "number": {
      "portions": {
        "default": "mdi:food-variant"
      }
    },
    "select": {
      "unit": {
        "default": "mdi:scale"
      },
      "home_area": {
        "default": "mdi:home-import-outline"
      }
    }
  },
  "services": {
    "estimate_best_before": {
      "service": "mdi:creation"
    },
    "clear_best_before": {
      "service": "mdi:calendar-remove"
    },
    "clear_filled_at": {
      "service": "mdi:calendar-remove"
    },
    "get_expiring": {
      "service": "mdi:calendar-alert"
    },
    "mark_opened": {
      "service": "mdi:package-variant"
    },
    "mark_thawed": {
      "service": "mdi:snowflake-melt"
    },
    "suggest_recipes": {
      "service": "mdi:chef-hat"
    },
    "rebuild_calendar": {
      "service": "mdi:calendar-sync"
    }
  }
